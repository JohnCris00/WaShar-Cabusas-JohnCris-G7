# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL (local) or Supabase (Project Settings > Database)
DB_NAME=washar
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432
# Use "require" for Supabase, "prefer" for local PostgreSQL
DB_SSLMODE=prefer
